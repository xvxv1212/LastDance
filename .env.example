# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.

# PostgreSQL (docker-compose.yml 이 이 값을 읽는다)
POSTGRES_USER=rights
POSTGRES_PASSWORD=
POSTGRES_DB=rights_chaebi
POSTGRES_PORT=5432

# 백엔드가 쓰는 접속 URL. 위 값과 맞춘다.
# 비밀번호에 특수문자(@ # % 등)가 있으면 URL 인코딩이 필요하므로 영문·숫자만 권장.
DATABASE_URL=postgresql+psycopg2://rights:비밀번호@localhost:5432/rights_chaebi

# 프론트엔드 개발 서버 주소 (CORS 허용 대상, 쉼표로 구분)
CORS_ORIGINS=http://localhost:5173

# LLM 제공자·키: 팀에서 모델을 정한 뒤 추가한다.

# PDF 업로드 제한. OCR은 아직 제공하지 않는다.
MAX_PDF_BYTES=10485760
MAX_PDF_PAGES=30
